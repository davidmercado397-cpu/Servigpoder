# Copiar a .env y ajustar valores. En Coolify se configuran como variables de entorno.

# Base de datos
POSTGRES_DB=capacidad
POSTGRES_USER=capacidad
POSTGRES_PASSWORD=cambiar-esta-clave

# Backend
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
# Autenticación: verificación en dos pasos (app Authenticator) y vencimiento de sesión.
# Desactivada por ahora; true para volver a exigirla
MFA_OBLIGATORIO=false
# true: el segundo paso se exige solo al rol Administrador; false: a todos los usuarios
MFA_SOLO_ADMINISTRADORES=true
MFA_EMISOR=Servigpoder
SESION_INACTIVIDAD_MIN=30
SESION_MAX_HORAS=12
# Minutos para escribir el código de verificación después de la contraseña
PREAUTH_MINUTOS=5
# true cuando el sitio se sirve por HTTPS (Coolify con dominio): activa cookie Secure y HSTS
COOKIE_SECURE=false
# production exige claves fuertes y desactiva /api/docs. Usar development solo en local.
ENVIRONMENT=production
# Hosts aceptados por el backend (coma separada). Detrás del proxy de Next.js llega "backend".
ALLOWED_HOSTS=*

# Enlace propio de cada empresa (coma separada): abre el login con su marca y trabaja en ella
DOMINIOS_EMPRESA=sera.nextbyte.com.co=sera
# Tamaño máximo de archivos subidos
MAX_UPLOAD_MB=15
# Rate limit: peticiones por IP y minuto (toda la API); bloqueo de login por intentos fallidos
RATE_LIMIT_GLOBAL=300
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15

# Usuario administrador inicial (se crea solo si no existe ningún usuario). Mínimo 12 caracteres.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar-esta-clave
ADMIN_NOMBRE=Administrador

# Puerto publicado del frontend en local
FRONTEND_PORT=3000

# Asistente de IA. Proveedor compatible con OpenAI; por defecto OpenRouter (clave en openrouter.ai/keys).
# Vacía = asistente desactivado. El modelo se elige de openrouter.ai/models (p. ej. anthropic/claude-opus-5).
IA_API_KEY=
IA_BASE_URL=https://openrouter.ai/api/v1
IA_MODELO=anthropic/claude-opus-5
# Solo proveedores con retención cero de datos (OpenRouter). Siempre se excluyen los que entrenan con los datos.
IA_ZDR=true
# Aprobado por protección de datos: enviar nombres y cédulas al modelo. false = seudónimos.
ASISTENTE_DATOS_PERSONALES=true
ASISTENTE_MAX_DIARIO=100

# Chat de instructivos SIESA: modelo propio (vacío = IA_MODELO) y tamaño máximo de cada PDF
SIESA_MODELO=
SIESA_MAX_PDF_MB=60

# Respaldo y restauración de la base comercial de Capacidad (solo para migrar entre instalaciones)
RESPALDO_COMERCIAL=false
