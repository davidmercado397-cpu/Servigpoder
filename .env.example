# Copiar a .env y ajustar valores. En Coolify se configuran como variables de entorno.

# Base de datos
POSTGRES_DB=capacidad
POSTGRES_USER=capacidad
POSTGRES_PASSWORD=cambiar-esta-clave

# Backend
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
# Autenticación: verificación en dos pasos obligatoria (app Authenticator) y vencimiento de sesión
MFA_OBLIGATORIO=true
MFA_EMISOR=Servigpoder
SESION_INACTIVIDAD_MIN=30
SESION_MAX_HORAS=12
# true cuando el sitio se sirve por HTTPS (Coolify con dominio): activa cookie Secure y HSTS
COOKIE_SECURE=false
# production exige claves fuertes y desactiva /api/docs. Usar development solo en local.
ENVIRONMENT=production
# Hosts aceptados por el backend (coma separada). Detrás del proxy de Next.js llega "backend".
ALLOWED_HOSTS=*
# Tamaño máximo de archivos subidos
MAX_UPLOAD_MB=15
# Rate limit: peticiones por IP y minuto (toda la API); bloqueo de login por intentos fallidos
RATE_LIMIT_GLOBAL=300
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15

# Usuario administrador inicial (se crea solo si no existe ningún usuario). Mínimo 12 caracteres.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar-esta-clave
ADMIN_NOMBRE=Administrador

# Puerto publicado del frontend en local
FRONTEND_PORT=3000

# Asistente de IA (F6). Clave de API creada en console.anthropic.com (no es la suscripción de claude.ai).
# Vacía = asistente desactivado.
ANTHROPIC_API_KEY=
ASISTENTE_MODELO=claude-opus-5
# Aprobado por protección de datos: enviar nombres y cédulas al modelo. false = seudónimos.
ASISTENTE_DATOS_PERSONALES=true
ASISTENTE_MAX_DIARIO=100
